From 652effa000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DymondZ <gh3ttokill4@gmail.com>
Date: Fri, 19 Jun 2026 22:31:00 +0200
Subject: [PATCH 3/5] sweet: powerhint: Drop obsolete top-app schedtune hints

The legacy /dev/stune top-app nodes are not present with the current kernel
scheduler. Avoid repeated failed writes from the power HAL.
---
 configs/power/powerhint.json | 30 ------------------------------
 1 file changed, 30 deletions(-)

diff --git a/configs/power/powerhint.json b/configs/power/powerhint.json
--- a/configs/power/powerhint.json
+++ b/configs/power/powerhint.json
@@ -101,24 +101,6 @@
       ],
       "ResetOnInit": true
     },
-    {
-      "Name": "TASchedtuneBoost",
-      "Path": "/dev/stune/top-app/schedtune.boost",
-      "Values": [
-        "40",
-        "10"
-      ],
-      "ResetOnInit": true
-    },
-    {
-      "Name": "TASchedtuneHighCap",
-      "Path": "/dev/stune/top-app/schedtune.prefer_high_cap",
-      "Values": [
-        "1",
-        "0"
-      ],
-      "ResetOnInit": true
-    },
     {
       "Name": "CPUBWHystTriggerCount",
       "Path": "/sys/class/devfreq/soc:qcom,cpu-cpu-llcc-bw/bw_hwmon/hyst_trigger_count",
@@ -325,18 +307,6 @@
       "Duration": 0,
       "Value": "1248000"
     },
-    {
-      "PowerHint": "INTERACTION",
-      "Node": "TASchedtuneBoost",
-      "Duration": 0,
-      "Value": "40"
-    },
-    {
-      "PowerHint": "INTERACTION",
-      "Node": "TASchedtuneHighCap",
-      "Duration": 0,
-      "Value": "1"
-    },
     {
       "PowerHint": "INTERACTION",
       "Node": "CPUBWHystTriggerCount",
-- 
